MODE=1
PROXY=true

JWT_SECRET=
JWT_ALGORITHM=

MONGO_HOST=
MONGO_PORT=
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_DB=

# Cloudflare
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
ACCOUNT_ID=
BUCKET_NAME=
MANAGER_BUCKET_NAME=
R2_MANAGER_PUBLIC_URL=

# CRAWLER
INTERNAL_API_KEY=
DATA_PATH=
CRAWLDATA_PATH=
CRAWLLOG_PATH=
ADMIN_TOKEN=

# MODEL
MODEL_PATH=

# SERVER
GPU_SERVER_URL=

MAIL_SENDER=
MAIL_PASSWORD=
OPENAI_API_KEY=

# LLM (OpenAI 호환 엔드포인트면 무엇이든 가능: vLLM / Ollama / LiteLLM / OpenAI 공식 등)
# 전역 모듈 system.llm: 로컬 서버는 URL만 설정하면 된다(인증 서버는 API 키도 필요).
# 매 요청 전 GET {LLM_BASE_URL}/models로 모델 ID를 조회한다.
# 여러 모델이 있으면 첫 번째 모델을 사용한다. LLM_MODEL은 사용하지 않는다.
LLM_BASE_URL=http://localhost:9001/v1
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_MAX_RETRIES=1
# 주 엔드포인트 실패 시 폴백 (비워두면 폴백 없음.
#  LLM_FALLBACK_BASE_URL 없이 키만 있으면 OpenAI 공식 API를 쓴다)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gpt-5-mini
# 구성원에게 안내하는 연구실 로컬 AI API (설정 창 > 로컬 AI API 에 표시, 로그인한 구성원만 볼 수 있음)
# 토큰을 비우면 LLM_API_KEY 를 보여 준다.
LAB_LLM_PUBLIC_URL=
LAB_LLM_PUBLIC_TOKEN=
# 사용자별 GPT API 키 암호화 비밀값(비우면 JWT_SECRET 사용). 바꾸면 저장된 키를 다시 입력해야 한다.
LLM_KEY_SECRET=
# 사용자별 GPT 요금표 덮어쓰기(100만 토큰당 USD): {"gpt-5-mini": [0.25, 2.0]}
LLM_PRICE_OVERRIDES=

# COMPLAINT (AI 고소장)
LAW_API_OC=
COMPLAINT_RETENTION_HOURS=72
COMPLAINT_LLM_JSON_MODE=1

# LOGGER
DISCORD_BOT_TOKEN=
