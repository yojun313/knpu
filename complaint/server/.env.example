# LLM 설정은 저장소 루트 .env 의 LLM_* 값을 공용 모듈(system.llm)이 읽는다.
OPENAI_API_KEY=
MAIL_PASSWORD=

# 국가법령정보센터 Open API 인증값(OC, 신청 시 등록한 이메일 ID).
# 설정하면 고소장 생성 때 판례를 실시간으로 추가 검색하고, build_kb.py 로
# 법령·판례 스냅샷(app/legal/data)을 새로 받을 때도 쓴다. 비워도 스냅샷으로 동작한다.
LAW_API_OC=

# 마지막 활동 후 사건·문서(암호화본) 보존 시간(시간 단위, 기본 3). 지나면 자동 삭제된다.
COMPLAINT_RETENTION_HOURS=3
# 허용할 Host 헤더(쉼표 구분). 비우면 기본값(complaint·dev.complaint 도메인, localhost)
COMPLAINT_ALLOWED_HOSTS=
# LLM 서버가 response_format=json_object 를 지원하지 않으면 0
COMPLAINT_LLM_JSON_MODE=1
